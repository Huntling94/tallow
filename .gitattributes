# Store text with LF line endings everywhere, so Windows and the Linux CI agree.
* text=auto eol=lf

# Windows scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.exr binary
*.hdr binary
*.glb binary
*.blend binary
*.fbx binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.res binary
*.scn binary
*.parquet binary
*.zip binary
*.pdf binary

# Language statistics: count docs as documentation.
docs/** linguist-documentation
